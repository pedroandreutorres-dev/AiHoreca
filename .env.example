GOOGLE_API_KEY=AIza...
COHERE_API_KEY=...

# Opcional (solo para persistencia remota de telemetría en despliegues cloud efímeros):
# HF_LOG_TOKEN=hf_...
# HF_LOG_DATASET_REPO=tu-usuario/tu-dataset-logs

# Opcional (Qdrant Cloud para escalar a todas las provincias sin superar límites de GitHub/RAM):
# QDRANT_URL=https://tu-cluster.cloud.qdrant.io:6333
# QDRANT_API_KEY=...

# Opcional (parametrización de modelos Gemini según cuota/tier):
# GEMINI_LITE_MODEL=gemini-3.1-flash-lite
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GEMINI_REASONING_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash
